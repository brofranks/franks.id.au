{% for year, posts in posts | groupbyYear %}
<h2 class="year">{{ year }}</h2>
<ul class="post-list">
  {% for post in posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | displayDate }}</time>
  </li>
  {% endfor %}
</ul>
{% endfor %}
